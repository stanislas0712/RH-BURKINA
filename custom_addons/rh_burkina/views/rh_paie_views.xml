                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rh_type_retenue" model="ir.actions.act_window">
        <field name="name">Types de retenues</field>
        <field name="res_model">rh.type.retenue</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_rh_retenue_list" model="ir.ui.view">
        <field name="name">rh.retenue.list</field>
        <field name="model">rh.retenue</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="type_retenue_id"/>
                <field name="recurrence"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="montant"/>
                <field name="taux" optional="show"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="bulletin_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_rh_retenue_form" model="ir.ui.view">
        <field name="name">rh.retenue.form</field>
        <field name="model">rh.retenue</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="base_calcul" invisible="1"/>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="type_retenue_id"/>
                            <field name="recurrence"/>
                            <field name="montant" invisible="base_calcul != 'fixe'"/>
                            <field name="taux" invisible="base_calcul == 'fixe'"/>
                        </group>
                        <group>
                            <field name="date_debut"/>
                            <field name="date_fin" invisible="recurrence == 'ponctuel'"/>
                            <field name="bulletin_id" invisible="not bulletin_id"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rh_retenue_search" model="ir.ui.view">
        <field name="name">rh.retenue.search</field>
        <field name="model">rh.retenue</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="type_retenue_id"/>
                <filter name="archived" string="Archivées" domain="[('active', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_type" string="Type" context="{'group_by': 'type_retenue_id'}"/>
                    <filter name="group_employe" string="Employé" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rh_retenue" model="ir.actions.act_window">
        <field name="name">Retenues</field>
        <field name="res_model">rh.retenue</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ═══════════════ Prêts et avances ═══════════════ -->
    <record id="view_rh_pret_form" model="ir.ui.view">
        <field name="name">rh.pret.form</field>
        <field name="model">rh.pret</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirmer" type="object" string="Confirmer et générer l'échéancier" class="btn-primary"
                            invisible="state != 'brouillon'" groups="rh_burkina.group_rh_paie,rh_burkina.group_rh_responsable"/>
                    <button name="action_annuler" type="object" string="Annuler"
                            invisible="state not in ('brouillon', 'en_cours')" groups="rh_burkina.group_rh_paie,rh_burkina.group_rh_responsable"
                            confirm="Annuler ce prêt ?"/>
                    <field name="state" widget="statusbar" statusbar_visible="brouillon,en_cours,solde"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <div class="text-muted"><field name="type_pret" readonly="state != 'brouillon'"/></div>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'brouillon'"/>
                            <field name="montant" readonly="state != 'brouillon'"/>
                            <field name="date_octroi" readonly="state != 'brouillon'"/>
                        </group>
                        <group>
                            <field name="nb_echeances" readonly="state != 'brouillon'"/>
                            <field name="date_premiere_echeance" readonly="state != 'brouillon'"/>
                            <field name="montant_rembourse"/>
                            <field name="solde_restant"/>
                        </group>
                    </group>
                    <field name="motif" placeholder="Objet du prêt…" readonly="state != 'brouillon'"/>
                    <field name="echeance_ids">
                        <list decoration-success="state == 'paye'">
                            <field name="numero"/>
                            <field name="date"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="montant" sum="Total"/>
                            <field name="state"/>
                            <field name="bulletin_id"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rh_pret_list" model="ir.ui.view">
        <field name="name">rh.pret.list</field>
        <field name="model">rh.pret</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('solde', 'annule')">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="type_pret"/>
                <field name="date_octroi"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="montant" sum="Total"/>
                <field name="solde_restant" sum="Total"/>
                <field name="nb_echeances"/>
                <field name="state" widget="badge" decoration-warning="state == 'en_cours'" decoration-success="state == 'solde'"/>
            </list>
        </field>
    </record>

    <record id="view_rh_pret_search" model="ir.ui.view">
        <field name="name">rh.pret.search</field>
        <field name="model">rh.pret</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <filter name="en_cours" string="En cours" domain="[('state', '=', 'en_cours')]"/>
                <filter name="soldes" string="Soldés" domain="[('state', '=', 'solde')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_type" string="Type" context="{'group_by': 'type_pret'}"/>
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rh_pret" model="ir.actions.act_window">
        <field name="name">Prêts et avances</field>
        <field name="res_model">rh.pret</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_en_cours': 1}</field>
    </record>

    <!-- ═══════════════ Assistants d'export ═══════════════ -->
    <record id="view_rh_wizard_export_paiement_form" model="ir.ui.view">
        <field name="name">rh.wizard.export.paiement.form</field>
        <field name="model">rh.wizard.export.paiement</field>
        <field name="arch" type="xml">
            <form string="Export des paiements">
                <group>
                    <field name="paie_id"/>
                    <field name="mode" widget="radio"/>
                    <field name="banque_id" invisible="mode != 'virement'"/>
                </group>
                <group invisible="not fichier">
                    <field name="fichier" filename="nom_fichier"/>
                    <field name="nom_fichier" invisible="1"/>
                </group>
                <footer>
                    <button name="action_generer" type="object" string="Générer le fichier" class="btn-primary"/>
                    <button special="cancel" string="Fermer" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rh_wizard_export_paiement" model="ir.actions.act_window">
        <field name="name">Export des paiements</field>
        <field name="res_model">rh.wizard.export.paiement</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_rh_wizard_declaration_form" model="ir.ui.view">
        <field name="name">rh.wizard.declaration.form</field>
        <field name="model">rh.wizard.declaration</field>
        <field name="arch" type="xml">
            <form string="Déclarations">
                <div class="alert alert-warning" role="alert">
                    ⚠️ États internes : le format exact des déclarations officielles est à vérifier auprès de la CNSS et de la DGI.
                </div>
                <group>
                    <field name="type_etat" widget="radio"/>
                    <field name="paie_id" invisible="type_etat == 'annuel'" required="type_etat != 'annuel'"/>
                    <field name="annee" invisible="type_etat != 'annuel'"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <group invisible="not fichier">
                    <field name="fichier" filename="nom_fichier"/>
                    <field name="nom_fichier" invisible="1"/>
                </group>
                <footer>
                    <button name="action_generer" type="object" string="Générer l'état Excel" class="btn-primary"/>
                    <button special="cancel" string="Fermer" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rh_wizard_declaration" model="ir.actions.act_window">
        <field name="name">Déclarations (CNSS, IUTS, récapitulatif annuel)</field>
        <field name="res_model">rh.wizard.declaration</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
