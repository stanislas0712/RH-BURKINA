<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="view_rh_formation_tree" model="ir.ui.view">
        <field name="name">rh.formation.tree</field>
        <field name="model">rh.formation</field>
        <field name="arch" type="xml">
            <list string="Formations" decoration-muted="not active">
                <field name="code"/>
                <field name="name"/>
                <field name="categorie"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="duree_jours"/>
                <field name="lieu"/>
                <field name="active" widget="boolean"/>
            </list>
        </field>
    </record>


    <record id="view_rh_formation_form" model="ir.ui.view">
        <field name="name">rh.formation.form</field>
        <field name="model">rh.formation</field>
        <field name="arch" type="xml">
            <form string="Formation / Atelier">
                <sheet>
                    <div class="rh_form_header">
                        <div class="rh_form_header_body">
                            <div class="rh_form_title">
                                <field name="name" placeholder="Intitulé de la formation" class="rh_field_nom"/>
                            </div>
                            <div class="rh_form_subtitle">
                                <field name="code" placeholder="Code"/>
                            </div>
                        </div>
                        <div class="rh_form_header_right">
                            <field name="active" widget="boolean_toggle"/>
                        </div>
                    </div>
                    <group col="2">
                        <group string="Planification">
                            <field name="categorie"/>
                            <field name="date_debut"/>
                            <field name="date_fin"/>
                            <field name="duree_jours"/>
                            <field name="lieu"/>
                            <field name="formateur"/>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Inscriptions">
                            <field name="inscription_ids">
                                <list>
                                    <field name="employe_id"/>
                                    <field name="date_inscription"/>
                                    <field name="statut" widget="badge"
                                           decoration-success="statut == 'termine'"
                                           decoration-warning="statut == 'confirme'"
                                           decoration-info="statut == 'inscrit'"
                                           decoration-danger="statut == 'annule'"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_rh_formation" model="ir.actions.act_window">
        <field name="name">Formations</field>
        <field name="res_model">rh.formation</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="view_rh_inscription_formation_tree" model="ir.ui.view">
        <field name="name">rh.inscription.formation.tree</field>
        <field name="model">rh.inscription.formation</field>
        <field name="arch" type="xml">
            <list string="Inscriptions aux Formations">
                <field name="employe_id"/>
                <field name="formation_id"/>
                <field name="date_inscription"/>
                <field name="statut" widget="badge"
                       decoration-success="statut == 'termine'"
                       decoration-warning="statut == 'confirme'"
                       decoration-info="statut == 'inscrit'"
                       decoration-danger="statut == 'annule'"/>
                <field name="note"/>
            </list>
        </field>
    </record>


    <record id="action_rh_inscription_formation" model="ir.actions.act_window">
        <field name="name">Inscriptions aux Formations</field>
        <field name="res_model">rh.inscription.formation</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="view_rh_evaluation_tree" model="ir.ui.view">
        <field name="name">rh.evaluation.tree</field>
        <field name="model">rh.evaluation</field>
        <field name="arch" type="xml">
            <list string="Évaluations">
                <field name="employe_id"/>
                <field name="date_evaluation"/>
                <field name="type_evaluation"/>
                <field name="note_globale"/>
                <field name="responsable_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'draft'"/>
            </list>
        </field>
    </record>


    <record id="view_rh_evaluation_form" model="ir.ui.view">
        <field name="name">rh.evaluation.form</field>
        <field name="model">rh.evaluation</field>
        <field name="arch" type="xml">
            <form string="Évaluation RH">
                <header>
                    <button name="action_valider" string="Valider"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'done'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="rh_form_header">
                        <div class="rh_form_header_body">
                            <div class="rh_form_title">
                                <field name="employe_id" placeholder="Employé évalué" class="rh_field_nom"/>
                            </div>
                            <div class="rh_form_subtitle">
                                <field name="type_evaluation"/> — <field name="date_evaluation"/>
                            </div>
                        </div>
                    </div>
                    <group col="2">
                        <group string="Évaluation">
                            <field name="type_evaluation"/>
                            <field name="date_evaluation"/>
                            <field name="responsable_id"/>
                            <field name="note_globale"/>
                        </group>
                        <group string="Commentaire">
                            <field name="commentaire" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_rh_evaluation" model="ir.actions.act_window">
        <field name="name">Évaluations</field>
        <field name="res_model">rh.evaluation</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>
