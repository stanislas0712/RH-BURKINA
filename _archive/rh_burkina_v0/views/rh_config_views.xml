<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="view_rh_departement_tree" model="ir.ui.view">
        <field name="name">rh.departement.tree</field>
        <field name="model">rh.departement</field>
        <field name="arch" type="xml">
            <list string="Départements / Directions" editable="bottom">
                <field name="code"/>
                <field name="nom"/>
                <field name="parent_id"/>
                <field name="responsable_id"/>
                <field name="nb_employes" readonly="1"/>
                <field name="active" widget="boolean"/>
            </list>
        </field>
    </record>


    <record id="view_rh_departement_form" model="ir.ui.view">
        <field name="name">rh.departement.form</field>
        <field name="model">rh.departement</field>
        <field name="arch" type="xml">
            <form string="Département / Direction">
                <sheet>
                    <div class="rh_form_header">
                        <div class="rh_form_header_body">
                            <div class="rh_form_title">
                                <field name="nom" placeholder="Nom du département" class="rh_field_nom"/>
                            </div>
                            <div class="rh_form_subtitle">
                                <field name="code" placeholder="Code (ex: RH, FIN)"/>
                            </div>
                        </div>
                        <div class="rh_form_header_right">
                            <field name="active" widget="boolean_toggle"/>
                        </div>
                    </div>
                    <group col="2">
                        <group string="Informations">
                            <field name="code"/>
                            <field name="parent_id"/>
                            <field name="responsable_id"/>
                            <field name="nb_employes" readonly="1"/>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Services rattachés">
                            <field name="service_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="nom"/>
                                    <field name="responsable_id"/>
                                    <field name="nb_employes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sous-départements">
                            <field name="child_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="nom"/>
                                    <field name="responsable_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_rh_departement" model="ir.actions.act_window">
        <field name="name">Départements</field>
        <field name="res_model">rh.departement</field>
        <field name="view_mode">kanban,list,form</field>
    </record>


    <record id="view_rh_service_tree" model="ir.ui.view">
        <field name="name">rh.service.tree</field>
        <field name="model">rh.service</field>
        <field name="arch" type="xml">
            <list string="Services" editable="bottom">
                <field name="code"/>
                <field name="nom"/>
                <field name="departement_id"/>
                <field name="responsable_id"/>
                <field name="nb_employes" readonly="1"/>
                <field name="active" widget="boolean"/>
            </list>
        </field>
    </record>


    <record id="view_rh_service_form" model="ir.ui.view">
        <field name="name">rh.service.form</field>
        <field name="model">rh.service</field>
        <field name="arch" type="xml">
            <form string="Service">
                <sheet>
                    <div class="rh_form_header">
                        <div class="rh_form_header_body">
                            <div class="rh_form_title">
                                <field name="nom" placeholder="Nom du service" class="rh_field_nom"/>
                            </div>
                            <div class="rh_form_subtitle">
                                <field name="code" placeholder="Code"/>
                            </div>
                        </div>
                        <div class="rh_form_header_right">
                            <field name="active" widget="boolean_toggle"/>
                        </div>
                    </div>
                    <group col="2">
                        <group string="Informations">
                            <field name="code"/>
                            <field name="departement_id"/>
                            <field name="responsable_id"/>
                            <field name="nb_employes" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Postes rattachés">
                            <field name="poste_ids">
                                <list>
                                    <field name="titre"/>
                                    <field name="statut" widget="badge"
                                           decoration-success="statut == 'actif'"
                                           decoration-warning="statut == 'en_recrutement'"
                                           decoration-danger="statut == 'obsolete'"/>
                                    <field name="nb_employes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_rh_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">rh.service</field>
        <field name="view_mode">kanban,list,form</field>
    </record>


    <record id="view_rh_poste_tree" model="ir.ui.view">
        <field name="name">rh.poste.tree</field>
        <field name="model">rh.poste</field>
        <field name="arch" type="xml">
            <list string="Postes" decoration-muted="statut == 'obsolete'">
                <field name="titre"/>
                <field name="code"/>
                <field name="service_id"/>
                <field name="poste_superieur_id"/>
                <field name="salaire_min"/>
                <field name="salaire_max"/>
                <field name="nb_employes" readonly="1"/>
                <field name="statut" widget="badge"
                       decoration-success="statut == 'actif'"
                       decoration-warning="statut == 'en_recrutement'"
                       decoration-danger="statut == 'obsolete'"/>
            </list>
        </field>
    </record>


    <record id="view_rh_poste_form" model="ir.ui.view">
        <field name="name">rh.poste.form</field>
        <field name="model">rh.poste</field>
        <field name="arch" type="xml">
            <form string="Poste / Emploi">
                <sheet>
                    <div class="rh_form_header">
                        <div class="rh_form_header_body">
                            <div class="rh_form_title">
                                <field name="titre" placeholder="Titre du poste" class="rh_field_nom"/>
                            </div>
                            <div class="rh_form_subtitle">
                                <field name="code" placeholder="Code poste"/>
                            </div>
                        </div>
                        <div class="rh_form_header_right">
                            <field name="statut" widget="badge"
                                   decoration-success="statut == 'actif'"
                                   decoration-warning="statut == 'en_recrutement'"
                                   decoration-danger="statut == 'obsolete'"/>
                        </div>
                    </div>
                    <group col="2">
                        <group string="Rattachement">
                            <field name="service_id"/>
                            <field name="poste_superieur_id"/>
                            <field name="nb_employes" readonly="1"/>
                        </group>
                        <group string="Grille salariale">
                            <field name="salaire_min"/>
                            <field name="salaire_max"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fiche de poste">
                            <group string="Description des missions">
                                <field name="description_missions" nolabel="1"/>
                            </group>
                            <group string="Compétences requises">
                                <field name="competences_requises" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Postes subordonnés">
                            <field name="postes_subordonnes_ids">
                                <list>
                                    <field name="titre"/>
                                    <field name="service_id"/>
                                    <field name="statut" widget="badge"/>
                                    <field name="nb_employes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_rh_poste" model="ir.actions.act_window">
        <field name="name">Postes</field>
        <field name="res_model">rh.poste</field>
        <field name="view_mode">kanban,list,form</field>
