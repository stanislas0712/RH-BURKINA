              name="Personnel"
              parent="menu_rh_root"
              sequence="10"/>
    <menuitem id="menu_rh_mon_dossier"
              name="Mon dossier"
              parent="menu_rh_personnel"
              action="action_rh_mon_dossier"
              groups="group_rh_employe"
              sequence="1"/>
