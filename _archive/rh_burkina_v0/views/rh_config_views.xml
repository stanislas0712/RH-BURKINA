    <!-- Liste générale -->
    <record id="view_rh_configuration_tree" model="ir.ui.view">
        <field name="name">rh.configuration.tree</field>
        <field name="model">rh.configuration</field>
        <field name="arch" type="xml">
            <list string="Configuration RH" editable="bottom">
                <field name="type_config"/>
                <field name="name" string="Libellé"/>
                <field name="date_application"/>
                <field name="active" widget="boolean"/>
            </list>
        </field>
    </record>


    <!-- Liste simplifiée pour chaque section (sans colonne type) -->
    <record id="view_rh_configuration_tree_simple" model="ir.ui.view">
        <field name="name">rh.configuration.tree.simple</field>
        <field name="model">rh.configuration</field>
        <field name="arch" type="xml">
            <list string="Éléments" editable="bottom">
                <field name="name" string="Libellé"/>
                <field name="date_application"/>
                <field name="active" widget="boolean"/>
            </list>
        </field>
    </record>


    <record id="view_rh_configuration_form" model="ir.ui.view">
        <field name="name">rh.configuration.form</field>
        <field name="model">rh.configuration</field>
        <field name="arch" type="xml">
            <form string="Configuration RH">
                <sheet>
                    <div class="rh_form_header">
                        <div class="rh_form_header_body">
                            <div class="rh_form_title">
                                <field name="name" placeholder="Libellé" class="rh_field_nom"/>
                            </div>
                        </div>
                        <div class="rh_form_header_right">
                            <field name="active" widget="boolean_toggle"/>
                        </div>
                    </div>

                    <group col="2">
                        <group string="Informations">
                            <field name="type_config"/>
                            <field name="date_application"/>
                        </group>
                        <!-- Paramètres légaux : visibles seulement pour poste/categorie -->
                        <group string="Paramètres légaux"
                               invisible="type_config not in ['poste', 'categorie']">
                            <field name="smig"/>
                            <field name="heures_semaine"/>
                            <field name="heures_mois"/>
                            <field name="jours_conge_annuel"/>
                        </group>
                    </group>
                    <group string="Taux heures supplémentaires"
                           invisible="type_config not in ['poste', 'categorie']">
                        <group>
                            <field name="taux_hs_25"/>
                        </group>
                        <group>
                            <field name="taux_hs_50"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_rh_departement_kanban" model="ir.ui.view">
        <field name="name">rh.departement.kanban</field>
        <field name="model">rh.departement</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="nom"/>
                <field name="code"/>
                <field name="responsable_id"/>
                <field name="nb_employes"/>
                <templates>
                    <t t-name="card">
                        <strong class="fs-5">[<field name="code"/>] <field name="nom"/></strong>
                        <div class="mt-1"><i class="fa fa-user me-1 text-muted" title="Responsable"/>
                            <field name="responsable_id"/></div>
                        <div class="mt-2 text-muted">
                            <i class="fa fa-users me-1" title="Employés"/>
                            <field name="nb_employes"/> employé(s)
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="view_rh_service_kanban" model="ir.ui.view">
        <field name="name">rh.service.kanban</field>
        <field name="model">rh.service</field>
        <field name="arch" type="xml">
            <kanban default_group_by="departement_id">
                <field name="nom"/>
                <field name="code"/>
                <field name="departement_id"/>
                <field name="responsable_id"/>
                <field name="nb_employes"/>
                <templates>
                    <t t-name="card">
                        <strong>[<field name="code"/>] <field name="nom"/></strong>
                        <div class="mt-1 text-muted small"><field name="departement_id"/></div>
                        <div><i class="fa fa-user me-1 text-muted" title="Responsable"/>
                            <field name="responsable_id"/></div>
                        <div class="mt-2 text-muted">
                            <i class="fa fa-users me-1" title="Employés"/>
                            <field name="nb_employes"/> employé(s)
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="view_rh_poste_kanban" model="ir.ui.view">
        <field name="name">rh.poste.kanban</field>
        <field name="model">rh.poste</field>
        <field name="arch" type="xml">
            <kanban default_group_by="statut">
                <field name="titre"/>
                <field name="code"/>
                <field name="service_id"/>
                <field name="statut"/>
                <field name="salaire_min"/>
                <field name="salaire_max"/>
                <field name="nb_employes"/>
                <templates>
                    <t t-name="card">
                        <strong><field name="titre"/></strong>
                        <t t-if="record.code.raw_value">
                            <span class="text-muted small"> (<field name="code"/>)</span>
                        </t>
                        <div class="mt-1"><i class="fa fa-sitemap me-1 text-muted" title="Service"/>
                            <field name="service_id"/></div>
                        <div class="text-muted small">
                            <field name="salaire_min"/> – <field name="salaire_max"/> FCFA
                        </div>
                        <div class="mt-2 d-flex justify-content-between">
                            <field name="statut" widget="badge"
                                   decoration-success="statut == 'actif'"
                                   decoration-warning="statut == 'en_recrutement'"
                                   decoration-danger="statut == 'obsolete'"/>
                            <span class="text-muted small">
                                <i class="fa fa-users me-1" title="Employés"/>
                                <field name="nb_employes"/>
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="view_rh_site_kanban" model="ir.ui.view">
        <field name="name">rh.site.kanban</field>
