    <!-- ═══════════════ Dossier du personnel (hr.employee) ═══════════════
         Les règles de groupe s'additionnent (OU) : chaque rôle voit au moins
         sa propre fiche, le chef son équipe, les rôles RH toutes les fiches.
         La règle multi-société standard du module hr reste appliquée. -->
    <record id="rule_hr_employee_rh_soi" model="ir.rule">
        <field name="name">RH Burkina – Employé : sa propre fiche</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_rh_employe'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_hr_employee_rh_chef" model="ir.rule">
        <field name="name">RH Burkina – Chef de département : son équipe</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">['|', ('department_id.manager_id.user_id', '=', user.id), ('parent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_rh_chef_departement'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_hr_employee_rh_tous" model="ir.rule">
        <field name="name">RH Burkina – Rôles RH : tous les dossiers</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_rh_lecture_personnel'))]"/>
    </record>

