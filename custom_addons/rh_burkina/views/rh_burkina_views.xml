<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ══════════════════════════════════════════════════════════════
     TABLEAU DE BORD
══════════════════════════════════════════════════════════════ -->

    <record id="view_rh_tableau_bord_form" model="ir.ui.view">
        <field name="name">rh.tableau.bord.form</field>
        <field name="model">rh.tableau.bord</field>
        <field name="arch" type="xml">
            <form string="Tableau de Bord RH" class="rh_dashboard_form" create="false" delete="false">
                <sheet>
                    <div class="rh_db_banner">
                        <div class="rh_db_banner_logo">
                            <img src="/rh_burkina/static/src/img/logo_rh_burkina.png"
                                 alt="RH Burkina" class="rh_db_logo_img"/>
                        </div>
                        <div class="rh_db_banner_center">
                            <div class="rh_db_main_title">RH BURKINA</div>
                            <div class="rh_db_tagline">Notre capital, l'humain</div>
                            <div class="rh_db_subtitle">Plateforme de Gestion des Ressources Humaines</div>
                        </div>
                        <div class="rh_db_banner_right">
                            <div class="rh_db_date_box">
                                <span class="rh_db_date_label">Mis à jour le</span>
                                <field name="date_reference" readonly="1" class="rh_db_date_val"/>
                            </div>
                        </div>
                    </div>

                    <div class="rh_db_section">
                        <div class="rh_db_section_title rh_db_section_green">
                            <span>👥</span><span>Effectifs</span>
                        </div>
                        <div class="rh_db_cards">
                            <div class="rh_db_card rh_db_card_green">
                                <div class="rh_db_card_icon">🏢</div>
                                <div class="rh_db_card_number"><field name="total_employes" readonly="1"/></div>
                                <div class="rh_db_card_label">Total Employés</div>
                            </div>
                            <div class="rh_db_card rh_db_card_green">
                                <div class="rh_db_card_icon">✅</div>
                                <div class="rh_db_card_number"><field name="employes_actifs" readonly="1"/></div>
                                <div class="rh_db_card_label">Actifs</div>
                            </div>
                            <div class="rh_db_card rh_db_card_green">
                                <div class="rh_db_card_icon">👨</div>
                                <div class="rh_db_card_number"><field name="employes_hommes" readonly="1"/></div>
                                <div class="rh_db_card_label">Hommes</div>
                            </div>
                            <div class="rh_db_card rh_db_card_green">
                                <div class="rh_db_card_icon">👩</div>
                                <div class="rh_db_card_number"><field name="employes_femmes" readonly="1"/></div>
                                <div class="rh_db_card_label">Femmes</div>
                            </div>
                            <div class="rh_db_card rh_db_card_grey">
                                <div class="rh_db_card_icon">⏸</div>
                                <div class="rh_db_card_number"><field name="employes_inactifs" readonly="1"/></div>
                                <div class="rh_db_card_label">Inactifs</div>
                            </div>
                        </div>
                    </div>

                    <div class="rh_db_section">
                        <div class="rh_db_section_title rh_db_section_blue">
                            <span>📄</span><span>Contrats &amp; Paie</span>
                        </div>
                        <div class="rh_db_cards">
                            <div class="rh_db_card rh_db_card_blue">
                                <div class="rh_db_card_icon">📋</div>
                                <div class="rh_db_card_number"><field name="contrats_actifs" readonly="1"/></div>
                                <div class="rh_db_card_label">Contrats Actifs</div>
                            </div>
                            <div class="rh_db_card rh_db_card_blue">
                                <div class="rh_db_card_icon">♾</div>
                                <div class="rh_db_card_number"><field name="contrats_cdi" readonly="1"/></div>
                                <div class="rh_db_card_label">CDI</div>
                            </div>
                            <div class="rh_db_card rh_db_card_blue">
                                <div class="rh_db_card_icon">📅</div>
                                <div class="rh_db_card_number"><field name="contrats_cdd" readonly="1"/></div>
                                <div class="rh_db_card_label">CDD</div>
                            </div>
                            <div class="rh_db_card rh_db_card_gold rh_db_card_wide">
                                <div class="rh_db_card_icon">💰</div>
                                <div class="rh_db_card_number rh_db_salary">
                                    <field name="masse_salariale" readonly="1" widget="float" digits="[16,0]"/>
                                </div>
                                <div class="rh_db_card_label">Masse Salariale (FCFA)</div>
                            </div>
                        </div>
                    </div>

                    <div class="rh_db_section">
                        <div class="rh_db_section_title rh_db_section_orange">
                            <span>🌴</span><span>Congés</span>
                        </div>
                        <div class="rh_db_cards">
                            <div class="rh_db_card rh_db_card_orange">
                                <div class="rh_db_card_icon">✈️</div>
                                <div class="rh_db_card_number"><field name="conges_en_cours" readonly="1"/></div>
                                <div class="rh_db_card_label">En Cours</div>
                            </div>
                            <div class="rh_db_card rh_db_card_orange">
                                <div class="rh_db_card_icon">⏳</div>
                                <div class="rh_db_card_number"><field name="conges_en_attente" readonly="1"/></div>
                                <div class="rh_db_card_label">En Attente d'Approbation</div>
                            </div>
                        </div>
                    </div>

                    <div class="rh_db_section">
                        <div class="rh_db_section_title rh_db_section_red">
                            <span>🎯</span><span>Recrutement</span>
                        </div>
                        <div class="rh_db_cards">
                            <div class="rh_db_card rh_db_card_red">
                                <div class="rh_db_card_icon">📢</div>
                                <div class="rh_db_card_number"><field name="recrutements_actifs" readonly="1"/></div>
                                <div class="rh_db_card_label">Postes Ouverts</div>
                            </div>
                            <div class="rh_db_card rh_db_card_red">
                                <div class="rh_db_card_icon">📩</div>
                                <div class="rh_db_card_number"><field name="candidatures" readonly="1"/></div>
                                <div class="rh_db_card_label">Candidatures reçues</div>
                            </div>
                        </div>
                    </div>

                    <div class="rh_db_section">
                        <div class="rh_db_section_title rh_db_section_purple">
                            <span>🎓</span><span>Formation</span>
                        </div>
                        <div class="rh_db_cards">
                            <div class="rh_db_card rh_db_card_purple">
                                <div class="rh_db_card_icon">📚</div>
                                <div class="rh_db_card_number"><field name="formations_total" readonly="1"/></div>
                                <div class="rh_db_card_label">Formations actives</div>
                            </div>
                            <div class="rh_db_card rh_db_card_purple">
                                <div class="rh_db_card_icon">🧑‍🎓</div>
                                <div class="rh_db_card_number"><field name="inscriptions_formation" readonly="1"/></div>
                                <div class="rh_db_card_label">Inscriptions</div>
                            </div>
                        </div>
                    </div>

                    <div class="rh_db_notes_section">
                        <group>
                            <field name="notes" placeholder="Notes et observations..." nolabel="1"/>
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rh_tableau_bord" model="ir.actions.server">
        <field name="name">Tableau de Bord RH</field>
        <field name="model_id" ref="model_rh_tableau_bord"/>
        <field name="state">code</field>
        <field name="code">
rec = env['rh.tableau.bord'].sudo().search([], limit=1)
if not rec:
    rec = env['rh.tableau.bord'].sudo().create({'name': 'Tableau de bord RH'})
action = {
    'type': 'ir.actions.act_window',
    'res_model': 'rh.tableau.bord',
    'res_id': rec.id,
    'view_mode': 'form',
    'views': [(False, 'form')],
    'target': 'current',
}
        </field>
    </record>

<!-- ══════════════════════════════════════════════════════════════
     EMPLOYÉS
══════════════════════════════════════════════════════════════ -->

    <record id="view_rh_employe_tree" model="ir.ui.view">
        <field name="name">rh.employe.tree</field>
        <field name="model">rh.employe</field>
        <field name="arch" type="xml">
            <list string="Employés" decoration-muted="statut != 'actif'">
                <field name="matricule"/>
                <field name="nom"/>
                <field name="prenom"/>
                <field name="genre"/>
                <field name="poste_id"/>
                <field name="departement_id"/>
                <field name="type_contrat"/>
                <field name="salaire_base"/>
                <field name="statut" widget="badge"
                       decoration-success="statut == 'actif'"
                       decoration-warning="statut == 'suspendu'"
                       decoration-danger="statut in ('licencie','demission')"
                       decoration-info="statut == 'retraite'"/>
            </list>
        </field>
    </record>

    <record id="view_rh_employe_form" model="ir.ui.view">
        <field name="name">rh.employe.form</field>
        <field name="model">rh.employe</field>
        <field name="arch" type="xml">
            <form string="Dossier Employé">
                <sheet>
                    <div class="rh_form_header">
                        <div class="rh_form_header_left">
                            <field name="photo" widget="image" class="rh_photo"
                                   options="{'size': [96, 96]}"/>
                        </div>
                        <div class="rh_form_header_body">
                            <div class="rh_form_title">
                                <field name="nom" placeholder="Nom" class="rh_field_nom"/>
                                <field name="prenom" placeholder="Prénom" class="rh_field_prenom"/>
                            </div>
                            <div class="rh_form_subtitle">
                                <field name="matricule" readonly="1" class="rh_badge_matricule"/>
                                <field name="poste_id" placeholder="Poste" class="rh_field_poste"/>
                            </div>
                        </div>
                        <div class="rh_form_header_right">
                            <field name="statut" widget="badge"
                                   decoration-success="statut == 'actif'"
                                   decoration-warning="statut == 'suspendu'"
                                   decoration-danger="statut in ('licencie','demission')"
                                   decoration-info="statut == 'retraite'"/>
                        </div>
                    </div>

                    <notebook>
                        <page string="Informations Personnelles" name="perso">
                            <group col="2">
                                <group string="Identité">
                                    <field name="genre"/>
                                    <field name="date_naissance"/>
                                    <field name="lieu_naissance"/>
                                    <field name="nationalite"/>
                                    <field name="situation_familiale"/>
                                    <field name="nombre_enfants"/>
                                </group>
                                <group string="Documents administratifs">
                                    <field name="numero_cnib"/>
                                    <field name="date_expiration_cnib"/>
                                    <field name="numero_cnss"/>
                                    <field name="numero_ifu"/>
                                </group>
                            </group>
                            <group string="Coordonnées">
                                <group>
                                    <field name="telephone"/>
                                    <field name="telephone2"/>
                                    <field name="email_perso"/>
                                    <field name="email_pro"/>
                                </group>
                                <group>
                                    <field name="adresse"/>
                                    <field name="ville"/>
                                    <field name="pays_id"/>
                                </group>
                            </group>
                        </page>

                        <page string="Poste &amp; Contrat" name="pro">
                            <group col="2">
                                <group string="Affectation">
                                    <field name="date_embauche"/>
                                    <field name="poste_id"/>
                                    <field name="departement_id"/>
                                    <field name="service_id"/>
                                    <field name="site_id"/>
                                    <field name="categorie_id"/>
                                    <field name="superieur_id"/>
                                </group>
                                <group string="Contrat &amp; Rémunération">
                                    <field name="type_contrat"/>
                                    <field name="date_fin_contrat"/>
                                    <field name="salaire_base"/>
                                    <field name="mode_paiement"/>
                                    <field name="banque"/>
                                    <field name="numero_compte"/>
                                </group>
                            </group>
                        </page>

                        <page string="Diplômes &amp; Formations" name="diplomes">
                            <field name="diplome_ids">
                                <list editable="bottom">
                                    <field name="type_diplome"/>
                                    <field name="intitule"/>
                                    <field name="etablissement"/>
                                    <field name="date_obtention"/>
                                    <field name="mention"/>
                                </list>
                            </field>
                        </page>

                        <page string="Documents" name="documents">
                            <field name="document_ids">
                                <list>
                                    <field name="type_document"/>
                                    <field name="titre"/>
                                    <field name="date_document"/>
                                    <field name="date_expiration"/>
                                    <field name="expire" widget="boolean"/>
                                </list>
                            </field>
                        </page>

                        <page string="Historique" name="historique">
                            <field name="historique_poste_ids">
                                <list editable="bottom">
                                    <field name="type_mouvement"/>
                                    <field name="nouveau_poste_id"/>
                                    <field name="nouveau_departement_id"/>
                                    <field name="date_debut"/>
                                    <field name="date_fin"/>
                                    <field name="motif"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

<!-- ══════════════════════════════════════════════════════════════
     CONTRATS
══════════════════════════════════════════════════════════════ -->

    <record id="view_rh_contrat_tree" model="ir.ui.view">
        <field name="name">rh.contrat.tree</field>
        <field name="model">rh.contrat</field>
        <field name="arch" type="xml">
            <list string="Contrats" decoration-muted="statut in ('expire','resilie')">
                <field name="reference"/>
                <field name="employe_id"/>
                <field name="type_contrat"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="salaire_base"/>
                <field name="statut" widget="badge"
                       decoration-success="statut == 'actif'"
                       decoration-info="statut == 'renouvele'"
                       decoration-warning="statut == 'brouillon'"
                       decoration-danger="statut in ('expire','resilie')"/>
            </list>
        </field>
    </record>

    <record id="view_rh_contrat_form" model="ir.ui.view">
        <field name="name">rh.contrat.form</field>
        <field name="model">rh.contrat</field>
        <field name="arch" type="xml">
            <form string="Contrat de Travail">
                <header>
                    <button name="action_activer" string="Activer" type="object"
                            class="btn-primary" invisible="statut == 'actif'"/>
                    <button name="action_resilier" string="Résilier" type="object"
                            class="btn-danger" invisible="statut in ('resilie','expire')"/>
                    <field name="statut" widget="statusbar"
                           statusbar_visible="brouillon,actif,expire,resilie"/>
                </header>
                <sheet>
                    <div class="rh_form_header">
                        <div class="rh_form_header_body">
                            <div class="rh_form_title">
                                <field name="reference" readonly="1" class="rh_badge_matricule"/>
                                <field name="employe_id" placeholder="Employé" class="rh_field_nom"/>
                            </div>
                            <div class="rh_form_subtitle">
                                <field name="type_contrat"/>
                            </div>
                        </div>
                    </div>
                    <group col="2">
                        <group string="Période">
                            <field name="date_debut"/>
                            <field name="date_fin"/>
                            <field name="duree_mois" readonly="1"/>
                            <field name="periode_essai_fin"/>
                        </group>
                        <group string="Rémunération">
                            <field name="poste_id"/>
                            <field name="salaire_base"/>
                            <field name="mode_paiement"/>
                        </group>
                    </group>
                    <group string="Clauses">
                        <group>
                            <field name="clause_confidentialite"/>
                            <field name="clause_non_concurrence"/>
                            <field name="duree_preavis"/>
                        </group>
                        <group>
                            <field name="contrat_precedent_id"/>
                            <field name="document" filename="nom_fichier"/>
                            <field name="nom_fichier" invisible="1"/>
                        </group>
                    </group>
                    <group string="Clauses particulières">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

<!-- ══════════════════════════════════════════════════════════════
     CONGÉS
══════════════════════════════════════════════════════════════ -->

    <record id="view_rh_conge_tree" model="ir.ui.view">
        <field name="name">rh.conge.tree</field>
        <field name="model">rh.conge</field>
        <field name="arch" type="xml">
            <list string="Congés" decoration-success="statut == 'accepte'"
                  decoration-danger="statut == 'refuse'"
                  decoration-muted="statut == 'brouillon'">
                <field name="reference"/>
                <field name="employe_id"/>
                <field name="type_conge_id"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="duree_jours"/>
                <field name="statut" widget="badge"
                       decoration-success="statut == 'accepte'"
                       decoration-warning="statut == 'en_cours'"
                       decoration-danger="statut == 'refuse'"
                       decoration-info="statut == 'brouillon'"/>
            </list>
        </field>
    </record>

    <record id="view_rh_conge_form" model="ir.ui.view">
        <field name="name">rh.conge.form</field>
        <field name="model">rh.conge</field>
        <field name="arch" type="xml">
            <form string="Demande de Congé">
                <header>
                    <button name="action_accepter" string="Approuver" type="object"
                            class="btn-primary" invisible="statut in ('accepte','refuse')"/>
                    <button name="action_refuser" string="Refuser" type="object"
                            class="btn-danger" invisible="statut in ('accepte','refuse')"/>
                    <field name="statut" widget="statusbar"
                           statusbar_visible="brouillon,en_cours,accepte,refuse"/>
                </header>
                <sheet>
                    <div class="rh_form_header">
                        <div class="rh_form_header_body">
                            <div class="rh_form_title">
                                <field name="reference" readonly="1" class="rh_badge_matricule"/>
                                <field name="employe_id" placeholder="Employé" class="rh_field_nom"/>
                            </div>
                            <div class="rh_form_subtitle">
                                <field name="type_conge_id"/>
                            </div>
                        </div>
                    </div>
                    <group col="2">
                        <group string="Période">
                            <field name="date_demande" readonly="1"/>
                            <field name="date_debut"/>
                            <field name="date_fin"/>
                            <field name="duree_jours" readonly="1"/>
                        </group>
                        <group string="Détails">
                            <field name="motif"/>
                            <field name="commentaire"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

<!-- ══════════════════════════════════════════════════════════════
     RECRUTEMENTS
══════════════════════════════════════════════════════════════ -->

    <record id="view_rh_recrutement_tree" model="ir.ui.view">
        <field name="name">rh.recrutement.tree</field>
        <field name="model">rh.recrutement</field>
        <field name="arch" type="xml">
            <list string="Recrutements">
                <field name="reference"/>
                <field name="titre_poste"/>
                <field name="departement_id"/>
                <field name="type_contrat"/>
                <field name="nombre_postes"/>
                <field name="nombre_candidats"/>
                <field name="date_cloture"/>
                <field name="statut" widget="badge"
                       decoration-success="statut == 'en_cours'"
                       decoration-info="statut == 'publie'"
                       decoration-warning="statut == 'brouillon'"
                       decoration-danger="statut in ('cloture','annule')"/>
            </list>
        </field>
    </record>

    <record id="view_rh_recrutement_form" model="ir.ui.view">
        <field name="name">rh.recrutement.form</field>
        <field name="model">rh.recrutement</field>
        <field name="arch" type="xml">
            <form string="Offre d'Emploi">
                <header>
                    <button name="action_publier" string="Publier" type="object"
                            class="btn-primary" invisible="statut != 'brouillon'"/>
                    <button name="action_cloturer" string="Clôturer" type="object"
                            class="btn-secondary" invisible="statut in ('cloture','annule','brouillon')"/>
                    <field name="statut" widget="statusbar"
                           statusbar_visible="brouillon,publie,en_cours,cloture"/>
                </header>
                <sheet>
                    <div class="rh_form_header">
                        <div class="rh_form_header_body">
                            <div class="rh_form_title">
                                <field name="reference" readonly="1" class="rh_badge_matricule"/>
                                <field name="titre_poste" placeholder="Titre du Poste" class="rh_field_nom"/>
                            </div>
                            <div class="rh_form_subtitle">
                                <field name="departement_id"/> — <field name="type_contrat"/>
                            </div>
                        </div>
                    </div>
                    <group col="2">
                        <group string="Poste">
                            <field name="poste_id"/>
                            <field name="nombre_postes"/>
                            <field name="niveau_etude"/>
                            <field name="experience_min"/>
                            <field name="lieu"/>
                        </group>
                        <group string="Calendrier &amp; Rémunération">
                            <field name="date_publication" readonly="1"/>
                            <field name="date_cloture"/>
                            <field name="salaire_min"/>
                            <field name="salaire_max"/>
                            <field name="responsable_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description du Poste">
                            <field name="description_poste" nolabel="1"/>
                        </page>
                        <page string="Profil Recherché">
                            <field name="profil_recherche" nolabel="1"/>
                        </page>
                        <page string="Candidatures">
                            <field name="candidat_ids">
                                <list>
                                    <field name="nom_complet"/>
                                    <field name="email"/>
                                    <field name="telephone"/>
                                    <field name="statut" widget="badge"
                                           decoration-success="statut == 'selectionne'"
                                           decoration-danger="statut == 'rejete'"
                                           decoration-info="statut == 'recu'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

<!-- ══════════════════════════════════════════════════════════════
     PRÉSENCES
══════════════════════════════════════════════════════════════ -->

    <record id="view_rh_presence_tree" model="ir.ui.view">
        <field name="name">rh.presence.tree</field>
        <field name="model">rh.presence</field>
        <field name="arch" type="xml">
            <list string="Présences" editable="bottom">
                <field name="employe_id"/>
                <field name="date"/>
                <field name="heure_arrivee" widget="float_time"/>
                <field name="heure_depart" widget="float_time"/>
                <field name="heures_travaillees" widget="float_time" readonly="1"/>
                <field name="heures_supplementaires" widget="float_time" readonly="1"/>
                <field name="statut" widget="badge"
                       decoration-success="statut == 'present'"
                       decoration-warning="statut in ('retard','teletravail')"
                       decoration-danger="statut == 'absent'"
                       decoration-info="statut in ('conge','mission','ferie')"/>
                <field name="valide" widget="boolean"/>
            </list>
        </field>
    </record>

    <record id="view_rh_presence_form" model="ir.ui.view">
        <field name="name">rh.presence.form</field>
        <field name="model">rh.presence</field>
        <field name="arch" type="xml">
            <form string="Pointage Présence">
                <sheet>
                    <group col="2">
                        <group string="Employé &amp; Date">
                            <field name="employe_id"/>
                            <field name="date"/>
                            <field name="statut"/>
                            <field name="type_pointage"/>
                        </group>
                        <group string="Horaires">
                            <field name="heure_arrivee" widget="float_time"/>
                            <field name="heure_depart" widget="float_time"/>
                            <field name="heures_normales"/>
                            <field name="heures_travaillees" widget="float_time" readonly="1"/>
                            <field name="heures_supplementaires" widget="float_time" readonly="1"/>
                        </group>
                    </group>
                    <group string="Validation">
                        <field name="valide"/>
                        <field name="valide_par" readonly="1"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

<!-- ══════════════════════════════════════════════════════════════
     CONFIGURATION
══════════════════════════════════════════════════════════════ -->

    <record id="view_rh_configuration_tree" model="ir.ui.view">
        <field name="name">rh.configuration.tree</field>
        <field name="model">rh.configuration</field>
        <field name="arch" type="xml">
            <list string="Configuration RH">
                <field name="type_config"/>
                <field name="name"/>
                <field name="active" widget="boolean"/>
            </list>
        </field>
    </record>

    <record id="view_rh_configuration_form" model="ir.ui.view">
        <field name="name">rh.configuration.form</field>
        <field name="model">rh.configuration</field>
        <field name="arch" type="xml">
            <form string="Configuration RH">
                <sheet>
                    <group col="2">
                        <group string="Identification">
                            <field name="type_config"/>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="date_application"/>
                        </group>
                        <group string="Paramètres légaux">
                            <field name="smig"/>
                            <field name="heures_semaine"/>
                            <field name="heures_mois"/>
                            <field name="jours_conge_annuel"/>
                        </group>
                    </group>
                    <group string="Heures supplémentaires">
                        <field name="taux_hs_25"/>
                        <field name="taux_hs_50"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

