<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="view_rh_employe_tree" model="ir.ui.view">
        <field name="name">rh.employe.tree</field>
        <field name="model">rh.employe</field>
        <field name="arch" type="xml">
            <list string="Employés" decoration-muted="statut != 'actif'">
                <field name="matricule"/>
                <field name="nom"/>
                <field name="prenom"/>
                <field name="genre"/>
                <field name="poste_id"/>
                <field name="departement_id"/>
                <field name="type_contrat"/>
                <field name="salaire_base"/>
                <field name="statut" widget="badge"
                       decoration-success="statut == 'actif'"
                       decoration-warning="statut == 'suspendu'"
                       decoration-danger="statut in ('licencie','demission')"
                       decoration-info="statut == 'retraite'"/>
            </list>
        </field>
    </record>


    <record id="view_rh_employe_form" model="ir.ui.view">
        <field name="name">rh.employe.form</field>
        <field name="model">rh.employe</field>
        <field name="arch" type="xml">
            <form string="Dossier Employé">
                <sheet>
                    <div class="rh_form_header">
                        <div class="rh_form_header_left">
                            <field name="photo" widget="image" class="rh_photo"
                                   options="{'size': [96, 96]}"/>
                        </div>
                        <div class="rh_form_header_body">
                            <div class="rh_form_title">
                                <field name="nom" placeholder="Nom" class="rh_field_nom"/>
                                <field name="prenom" placeholder="Prénom" class="rh_field_prenom"/>
                            </div>
                            <div class="rh_form_subtitle">
                                <field name="matricule" readonly="1" class="rh_badge_matricule"/>
                            </div>
                        </div>
                        <div class="rh_form_header_right">
                            <field name="statut" widget="badge"
                                   decoration-success="statut == 'actif'"
                                   decoration-warning="statut == 'suspendu'"
                                   decoration-danger="statut in ('licencie','demission')"
                                   decoration-info="statut == 'retraite'"/>
                        </div>
                    </div>

                    <notebook>
                        <page string="Informations Personnelles" name="perso">
                            <group col="2">
                                <group string="Identité">
                                    <field name="genre"/>
                                    <field name="date_naissance"/>
                                    <field name="lieu_naissance"/>
                                    <field name="nationalite"/>
                                    <field name="situation_familiale"/>
                                    <field name="nombre_enfants"/>
                                </group>
                                <group string="Documents administratifs">
                                    <field name="numero_cnib"/>
                                    <field name="date_expiration_cnib"/>
                                    <field name="numero_cnss"/>
                                    <field name="numero_ifu"/>
                                </group>
                            </group>
                            <group string="Coordonnées">
                                <group>
                                    <field name="telephone"/>
                                    <field name="telephone2"/>
                                    <field name="email_perso"/>
                                    <field name="email_pro"/>
                                </group>
                                <group>
                                    <field name="adresse"/>
                                    <field name="ville"/>
                                    <field name="pays_id"/>
                                </group>
                            </group>
                        </page>

                        <page string="Poste &amp; Contrat" name="pro">
                            <group col="2">
                                <group string="Affectation">
                                    <field name="date_embauche"/>
                                    <field name="poste_id"/>
                                    <field name="departement_id"/>
                                    <field name="service_id"/>
                                    <field name="site_id"/>
                                    <field name="categorie_id"/>
                                    <field name="superieur_id"/>
                                </group>
                                <group string="Contrat &amp; Rémunération">
                                    <field name="type_contrat"/>
                                    <field name="date_fin_contrat"/>
                                    <field name="salaire_base"/>
                                    <field name="mode_paiement"/>
                                    <field name="banque"/>
                                    <field name="numero_compte"/>
                                    <field name="user_id"
                                           groups="rh_burkina.group_rh_manager,rh_burkina.group_rh_admin,base.group_system"
                                           help="Lier ce compte utilisateur Odoo à cet employé pour activer le self-service RH."/>
                                </group>
                            </group>
                        </page>

                        <page string="Diplômes &amp; Formations" name="diplomes">
                            <field name="diplome_ids">
                                <list editable="bottom">
                                    <field name="type_diplome"/>
                                    <field name="intitule"/>
                                    <field name="etablissement"/>
                                    <field name="date_obtention"/>
                                    <field name="mention"/>
                                </list>
                            </field>
                        </page>

                        <page string="Documents" name="documents">
                            <field name="document_ids">
                                <list>
                                    <field name="type_document"/>
                                    <field name="titre"/>
                                    <field name="date_document"/>
                                    <field name="date_expiration"/>
                                    <field name="expire" widget="boolean"/>
                                </list>
                            </field>
                        </page>

                        <page string="Historique" name="historique">
                            <field name="historique_poste_ids">
                                <list editable="bottom">
                                    <field name="type_mouvement"/>
                                    <field name="nouveau_poste_id"/>
                                    <field name="nouveau_departement_id"/>
                                    <field name="date_debut"/>
                                    <field name="date_fin"/>
                                    <field name="motif"/>
                                </list>
                            </field>
                        </page>

                        <page string="Contacts d'Urgence" name="contacts_urgence">
                            <field name="contact_urgence_ids">
                                <list editable="bottom">
                                    <field name="priorite"/>
                                    <field name="nom"/>
                                    <field name="lien"/>
                                    <field name="telephone"/>
                                    <field name="telephone2"/>
                                    <field name="email"/>
                                </list>
                            </field>
                        </page>

                        <page string="Évaluations" name="evaluations"
                              groups="rh_burkina.group_rh_user,rh_burkina.group_rh_chef_dept,rh_burkina.group_rh_directeur,rh_burkina.group_rh_auditeur,base.group_system">
                            <field name="evaluation_ids">
                                <list>
                                    <field name="date_evaluation"/>
                                    <field name="type_evaluation"/>
                                    <field name="note_globale"/>
                                    <field name="responsable_id"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'done'"
                                           decoration-warning="state == 'draft'"/>
                                </list>
                            </field>
                        </page>

                        <page string="Primes &amp; Retenues" name="paie_details"
                              groups="rh_burkina.group_rh_user,rh_burkina.group_rh_paie,rh_burkina.group_rh_manager,rh_burkina.group_rh_directeur,base.group_system">
                            <group string="Primes">
                                <field name="prime_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="type_prime"/>
                                        <field name="name"/>
                                        <field name="montant"/>
                                        <field name="date_effet"/>
                                        <field name="active" widget="boolean"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Retenues Personnelles">
                                <field name="retenue_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="type_retenue"/>
                                        <field name="name"/>
                                        <field name="montant"/>
                                        <field name="date_effet"/>
                                        <field name="active" widget="boolean"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="view_rh_employe_kanban" model="ir.ui.view">
        <field name="name">rh.employe.kanban</field>
        <field name="model">rh.employe</field>
        <field name="arch" type="xml">
            <kanban default_group_by="statut" class="o_kanban_small_column">
                <field name="nom_complet"/>
                <field name="matricule"/>
                <field name="poste_id"/>
                <field name="departement_id"/>
                <field name="service_id"/>
                <field name="statut"/>
                <field name="photo"/>
                <field name="type_contrat"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-start">
                            <div class="flex-grow-1">
                                <strong class="fs-5"><field name="nom_complet"/></strong>
                                <div class="text-muted small"><field name="matricule"/></div>
                                <div class="mt-1"><i class="fa fa-briefcase me-1 text-muted" title="Poste"/>
                                    <field name="poste_id"/></div>
                                <div><i class="fa fa-building me-1 text-muted" title="Département"/>
                                    <field name="departement_id"/></div>
                                <div><i class="fa fa-sitemap me-1 text-muted" title="Service"/>
                                    <field name="service_id"/></div>
                            </div>
                            <div style="width:56px;height:56px;border-radius:50%;overflow:hidden;flex-shrink:0">
                                <field name="photo" widget="image" options="{'preview_image': 'photo'}"/>
                            </div>
                        </div>
                        <div class="mt-2 d-flex justify-content-between align-items-center">
                            <field name="statut" widget="badge"
                                   decoration-success="statut == 'actif'"
                                   decoration-warning="statut == 'suspendu'"
                                   decoration-danger="statut in ('licencie','demission','inactif')"
                                   decoration-info="statut == 'retraite'"/>
                            <span class="text-muted small"><field name="type_contrat"/></span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="action_rh_employe" model="ir.actions.act_window">
        <field name="name">Employés</field>
        <field name="res_model">rh.employe</field>
        <field name="view_mode">kanban,list,form</field>
    </record>


</odoo>
