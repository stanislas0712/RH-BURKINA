                            <field name="ville"/></div>
                        <div><i class="fa fa-user me-1 text-muted" title="Responsable"/>
                            <field name="responsable_id"/></div>
                        <div class="mt-2 text-muted">
                            <i class="fa fa-users me-1" title="Employés"/>
                            <field name="nb_employes"/> employé(s)
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="view_rh_categorie_kanban" model="ir.ui.view">
        <field name="name">rh.categorie.kanban</field>
        <field name="model">rh.categorie</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="nom"/>
                <field name="code"/>
                <field name="niveau"/>
                <field name="salaire_min"/>
                <field name="salaire_max"/>
                <field name="nb_employes"/>
                <templates>
                    <t t-name="card">
                        <strong>[<field name="code"/>] <field name="nom"/></strong>
                        <div class="mt-1 text-muted small">Échelon <field name="niveau"/></div>
                        <div>
                            <field name="salaire_min"/> – <field name="salaire_max"/> FCFA
                        </div>
                        <div class="mt-2 text-muted">
                            <i class="fa fa-users me-1" title="Employés"/>
                            <field name="nb_employes"/> employé(s)
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="view_rh_type_prime_kanban" model="ir.ui.view">
        <field name="name">rh.type.prime.kanban</field>
        <field name="model">rh.type.prime</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="nom"/>
                <field name="code"/>
                <field name="est_imposable"/>
                <field name="montant_fixe"/>
                <field name="taux_pourcentage"/>
                <templates>
                    <t t-name="card">
                        <strong>[<field name="code"/>] <field name="nom"/></strong>
                        <div class="mt-1">
                            <t t-if="record.montant_fixe.raw_value">
                                <i class="fa fa-money me-1 text-muted" title="Montant"/>
                                <field name="montant_fixe"/> FCFA
                            </t>
                            <t t-if="record.taux_pourcentage.raw_value">
                                <i class="fa fa-percent me-1 text-muted" title="Taux"/>
                                <field name="taux_pourcentage"/> %
                            </t>
                        </div>
                        <div class="mt-2">
                            <t t-if="record.est_imposable.raw_value">
                                <span class="badge bg-warning">Imposable ITS</span>
                            </t>
                            <t t-else="">
                                <span class="badge bg-success">Non imposable</span>
                            </t>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="view_rh_type_retenue_kanban" model="ir.ui.view">
        <field name="name">rh.type.retenue.kanban</field>
        <field name="model">rh.type.retenue</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="nom"/>
                <field name="code"/>
                <field name="taux"/>
                <field name="base_calcul"/>
                <field name="est_obligatoire"/>
                <templates>
                    <t t-name="card">
                        <strong>[<field name="code"/>] <field name="nom"/></strong>
                        <div class="mt-1">
                            <i class="fa fa-percent me-1 text-muted" title="Taux"/>
                            <field name="taux"/> % sur <field name="base_calcul"/>
                        </div>
                        <div class="mt-2">
                            <t t-if="record.est_obligatoire.raw_value">
                                <span class="badge bg-danger">Obligatoire</span>
                            </t>
                            <t t-else="">
                                <span class="badge bg-secondary">Facultatif</span>
                            </t>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="view_rh_cnss_tree" model="ir.ui.view">
        <field name="name">rh.cnss.tree</field>
        <field name="model">rh.cnss</field>
        <field name="arch" type="xml">
            <list string="Configuration CNSS" editable="bottom"
                  decoration-success="active == True">
                <field name="name"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="taux_cnss_salarie"/>
                <field name="taux_cnss_patronal"/>
                <field name="plafond_mensuel"/>
                <field name="active" widget="boolean"/>
            </list>
        </field>
    </record>


    <record id="view_rh_cnss_form" model="ir.ui.view">
        <field name="name">rh.cnss.form</field>
        <field name="model">rh.cnss</field>
        <field name="arch" type="xml">
            <form string="Configuration CNSS">
                <sheet>
                    <div class="rh_form_header">
                        <div class="rh_form_header_body">
                            <div class="rh_form_title">
                                <field name="name" placeholder="Ex : CNSS 2024" class="rh_field_nom"/>
                            </div>
                        </div>
                        <div class="rh_form_header_right">
                            <field name="active" widget="boolean_toggle"/>
                        </div>
                    </div>
                    <group col="2">
                        <group string="Période d'application">
                            <field name="date_debut"/>
                            <field name="date_fin"/>
                        </group>
                        <group string="Plafond">
                            <field name="plafond_mensuel"/>
                        </group>
                    </group>
                    <group col="2">
                        <group string="Cotisations Salariales">
                            <field name="taux_cnss_salarie"/>
                        </group>
                        <group string="Cotisations Patronales">
                            <field name="taux_cnss_patronal"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_rh_cnss" model="ir.actions.act_window">
        <field name="name">Configuration CNSS</field>
        <field name="res_model">rh.cnss</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="view_rh_iuts_tree" model="ir.ui.view">
        <field name="name">rh.iuts.tree</field>
        <field name="model">rh.iuts</field>
        <field name="arch" type="xml">
            <list string="Barème IUTS" editable="bottom">
                <field name="name"/>
                <field name="revenu_min"/>
                <field name="revenu_max"/>
                <field name="taux"/>
                <field name="deduction_fixe"/>
                <field name="active" widget="boolean"/>
            </list>
        </field>
    </record>


    <record id="view_rh_iuts_form" model="ir.ui.view">
        <field name="name">rh.iuts.form</field>
        <field name="model">rh.iuts</field>
        <field name="arch" type="xml">
            <form string="Tranche IUTS">
                <sheet>
                    <div class="rh_form_header">
                        <div class="rh_form_header_body">
                            <div class="rh_form_title">
                                <field name="name" placeholder="Ex : Tranche 1 (0–50 000)" class="rh_field_nom"/>
                            </div>
                        </div>
                        <div class="rh_form_header_right">
                            <field name="active" widget="boolean_toggle"/>
                        </div>
                    </div>
                    <group col="2">
                        <group string="Tranche (FCFA)">
                            <field name="revenu_min"/>
                            <field name="revenu_max"/>
                        </group>
                        <group string="Calcul">
                            <field name="taux"/>
                            <field name="deduction_fixe"
                                   help="Déduction forfaitaire pour convertir le taux marginal en résultat progressif correct. Formule : IUTS = (salaire × taux%) − déduction_fixe"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_rh_iuts" model="ir.actions.act_window">
        <field name="name">Barème IUTS</field>
        <field name="res_model">rh.iuts</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="action_rh_configuration" model="ir.actions.act_window">
        <field name="name">Configuration RH (tout)</field>
        <field name="res_model">rh.configuration</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         SECTION RÔLES (res.groups)
         Liste des groupes RH + formulaire avec onglet Utilisateurs
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- Vue liste — Rôles RH -->
    <record id="view_rh_roles_list" model="ir.ui.view">
        <field name="name">res.groups.rh.burkina.list</field>
        <field name="model">res.groups</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Rôles RH" create="false" delete="false">
                <field name="name" string="Rôle"/>
                <field name="category_id" string="Catégorie"/>
                <field name="comment" string="Description" optional="show"/>
                <field name="nb_utilisateurs" string="Utilisateurs"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire — Rôle RH avec notebook onglet Utilisateurs -->
    <record id="view_rh_groups_form" model="ir.ui.view">
        <field name="name">res.groups.rh.burkina.form</field>
        <field name="model">res.groups</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Rôle RH" create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" string="Rôle" readonly="1"/></h1>
                    </div>
                    <group col="2">
                        <group string="Informations">
                            <field name="category_id" string="Catégorie" readonly="1"/>
                            <field name="nb_utilisateurs" string="Utilisateurs assignés" readonly="1"/>
                        </group>
                        <group string="Description">
                            <field name="comment" nolabel="1" readonly="1"
                                   placeholder="Description du rôle..."/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Onglet principal : liste des utilisateurs rattachés à ce rôle -->
                        <page string="Utilisateurs assignés" name="utilisateurs">
                            <field name="users" nolabel="1" readonly="1">
                                <list>
                                    <field name="name" string="Nom complet"/>
                                    <field name="login" string="Identifiant"/>
                                    <field name="email" string="Email" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <!-- Onglet secondaire : groupes impliqués par ce rôle -->
                        <page string="Permissions héritées" name="permissions">
                            <field name="implied_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name" string="Groupe"/>
                                    <field name="category_id" string="Catégorie"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action — Rôles RH (liste + formulaire) -->
    <record id="action_rh_roles" model="ir.actions.act_window">
        <field name="name">Rôles</field>
        <field name="res_model">res.groups</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('category_id.name', 'in', ['RH Burkina', 'RH - Fonctions spéciales'])]</field>
        <field name="context">{}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_rh_roles_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_rh_groups_form')})]"/>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         SECTION UTILISATEURS (res.users)
         Liste regroupable par rôle + formulaire simplifié
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- Vue liste — Utilisateurs RH avec colonne Rôle RH -->
    <record id="view_rh_users_list" model="ir.ui.view">
        <field name="name">res.users.rh.burkina.list</field>
        <field name="model">res.users</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Utilisateurs RH" create="false">
                <field name="name" string="Nom complet"/>
                <field name="login" string="Identifiant"/>
                <field name="email" string="Email" optional="show"/>
                <field name="role_rh_id" string="Rôle RH"/>
                <field name="active" string="Actif" widget="boolean" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Vue recherche — filtre « Regrouper par Rôle RH » activé par défaut -->
    <record id="view_rh_users_search" model="ir.ui.view">
        <field name="name">res.users.rh.burkina.search</field>
        <field name="model">res.users</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search string="Recherche utilisateurs">
                <field name="name" string="Nom"/>
                <field name="login" string="Identifiant"/>
                <field name="email" string="Email"/>
                <field name="role_rh_id" string="Rôle RH"/>
                <!-- Filtres prédéfinis -->
                <filter name="filter_actifs" string="Actifs"
                        domain="[('active', '=', True)]"/>
                <filter name="filter_sans_role" string="Sans rôle RH"
                        domain="[('role_rh_id', '=', False)]"/>
                <separator/>
                <!-- Regroupement par rôle RH — activé par défaut via le contexte de l'action -->
                <filter name="group_by_role" string="Rôle RH"
                        context="{'group_by': 'role_rh_id'}"/>
            </search>
        </field>
    </record>

    <!-- Vue formulaire — Utilisateur RH (centrée sur l'identité et le rôle) -->
    <record id="view_rh_users_form" model="ir.ui.view">
        <field name="name">res.users.rh.burkina.form</field>
        <field name="model">res.users</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Utilisateur RH">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" string="Nom complet"/></h1>
                    </div>
                    <group col="2">
                        <group string="Compte">
                            <field name="login" string="Identifiant"/>
                            <field name="email" string="Email"/>
                        </group>
                        <group string="Accès RH">
                            <!-- Calculé depuis les groupes — lecture seule -->
                            <field name="role_rh_id" string="Rôle principal" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action — Utilisateurs (groupés par rôle RH dès l'ouverture) -->
    <record id="action_rh_utilisateurs_roles" model="ir.actions.act_window">
        <field name="name">Utilisateurs</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('share', '=', False)]</field>
        <!-- search_default_group_by_role active le regroupement par Rôle RH par défaut -->
        <field name="context">{'search_default_group_by_role': 1}</field>
        <!-- search_view_id : seule façon valide de lier une vue search à une action dans Odoo 18 -->
        <field name="search_view_id" ref="view_rh_users_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_rh_users_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_rh_users_form')})]"/>
    </record>


</odoo>
