<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Séquences de la société principale ; dupliquées automatiquement
         pour chaque autre société (res.company._rh_create_sequences). -->
    <record id="seq_rh_employe" model="ir.sequence">
        <field name="name">RH – Matricule employé</field>
        <field name="code">rh.employe</field>
        <field name="prefix">EMP-</field>
        <field name="padding">4</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="seq_rh_recrutement" model="ir.sequence">
        <field name="name">RH – Offre de recrutement</field>
        <field name="code">rh.recrutement</field>
        <field name="prefix">REC-</field>
        <field name="padding">4</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="seq_rh_candidat" model="ir.sequence">
        <field name="name">RH – Candidat</field>
        <field name="code">rh.candidat</field>
        <field name="prefix">CAND-</field>
        <field name="padding">4</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="seq_rh_contrat" model="ir.sequence">
        <field name="name">RH – Contrat de travail</field>
        <field name="code">rh.contrat</field>
        <field name="prefix">CTR-</field>
        <field name="padding">4</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="seq_rh_conge" model="ir.sequence">
        <field name="name">RH – Demande de congé</field>
        <field name="code">rh.conge</field>
        <field name="prefix">CNG-</field>
        <field name="padding">4</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="seq_rh_bulletin_paie" model="ir.sequence">
        <field name="name">RH – Bulletin de paie</field>
        <field name="code">rh.bulletin.paie</field>
        <field name="prefix">BP-</field>
        <field name="padding">5</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="seq_rh_paie" model="ir.sequence">
        <field name="name">RH – Période de paie</field>
        <field name="code">rh.paie</field>
        <field name="prefix">PAI-</field>
        <field name="padding">4</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="seq_rh_sanction" model="ir.sequence">
        <field name="name">RH – Sanction</field>
        <field name="code">rh.sanction</field>
        <field name="prefix">SANC-</field>
        <field name="padding">4</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="seq_rh_pret" model="ir.sequence">
        <field name="name">RH – Prêt / avance</field>
        <field name="code">rh.pret</field>
        <field name="prefix">PRT-</field>
        <field name="padding">4</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="seq_rh_sortie" model="ir.sequence">
        <field name="name">RH – Sortie du personnel</field>
        <field name="code">rh.sortie</field>
        <field name="prefix">SORT-</field>
        <field name="padding">4</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
</odoo>
