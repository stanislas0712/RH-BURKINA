<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════════════════
             PARTIE 1 — CATÉGORIES DE MODULES
             ───────────────────────────────────────────────────────────────
             Catégorie 1 : rôles hiérarchiques → rendu Selection dans
                           le formulaire utilisateur (mutuellement exclusifs).
             Catégorie 2 : rôles fonctionnels cumulables → cases à cocher.
        ════════════════════════════════════════════════════════════════ -->

        <record id="module_category_rh_burkina" model="ir.module.category">
            <field name="name">RH Burkina</field>
            <field name="description">Rôles hiérarchiques — Gestion RH Burkina Faso</field>
            <field name="sequence">100</field>
            <field name="visible">1</field>
        </record>

        <record id="module_category_rh_fonctions_speciales" model="ir.module.category">
            <field name="name">RH - Fonctions spéciales</field>
            <field name="description">Rôles fonctionnels transversaux — cumulables</field>
            <field name="sequence">101</field>
            <field name="visible">1</field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════
             PARTIE 2 — GROUPES DE SÉCURITÉ
             ───────────────────────────────────────────────────────────────
             HIÉRARCHIE PRINCIPALE (catégorie 1 → champ Selection)
             Employé ⊂ Gestionnaire RH ⊂ Responsable RH ⊂ Administrateur

             implied_ids : "avoir A accorde automatiquement B"
               admin      → accorde manager
               manager    → accorde user
               user       → accorde employe
               chef_dept  → accorde employe (périmètre département)

             FONCTIONS SPÉCIALES (catégorie 2 → cases à cocher, cumulables)
               directeur  → implique employe  (lecture seule stratégique)
               paie       → implique user     (données salariales)
               recruteur  → implique user     (recrutement)
               formation  → implique user     (formation)
               auditeur   → aucun implied     (lecture seule totale)
        ════════════════════════════════════════════════════════════════ -->

        <!-- ── Niveau 1 : Employé ────────────────────────────────────── -->
        <record id="group_rh_employe" model="res.groups">
            <field name="name">Employé</field>
            <field name="category_id" ref="module_category_rh_burkina"/>
            <field name="comment">Consulte son profil, soumet des demandes de congé, consulte ses fiches de paie et évaluations.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- ── Niveau 2 : Gestionnaire RH ───────────────────────────── -->
        <record id="group_rh_user" model="res.groups">
            <field name="name">Gestionnaire RH</field>
            <field name="category_id" ref="module_category_rh_burkina"/>
            <field name="comment">Gestion quotidienne : employés, contrats, congés, présences, formations et évaluations.</field>
            <field name="implied_ids" eval="[(4, ref('group_rh_employe'))]"/>
        </record>

        <!-- ── Niveau 3 : Responsable RH ────────────────────────────── -->
        <record id="group_rh_manager" model="res.groups">
            <field name="name">Responsable RH</field>
            <field name="category_id" ref="module_category_rh_burkina"/>
            <field name="comment">Validation et approbation des demandes. Gestion complète des dossiers du personnel.</field>
            <field name="implied_ids" eval="[(4, ref('group_rh_user'))]"/>
        </record>

        <!-- ── Niveau 4 : Administrateur ───────────────────────────── -->
        <record id="group_rh_admin" model="res.groups">
            <field name="name">Administrateur</field>
            <field name="category_id" ref="module_category_rh_burkina"/>
            <field name="comment">Gère toute la plateforme, les utilisateurs, les permissions et les paramètres du système.</field>
            <field name="implied_ids" eval="[(4, ref('group_rh_manager'))]"/>
        </record>

        <!-- ── Chef de Département (catégorie 2, cumulable avec tout rôle hiérarchique) -->
        <record id="group_rh_chef_dept" model="res.groups">
            <field name="name">Chef de Département</field>
            <field name="category_id" ref="module_category_rh_fonctions_speciales"/>
            <field name="comment">Gère les employés de son département : validation des congés, évaluations, suivi des présences.</field>
            <field name="implied_ids" eval="[(4, ref('group_rh_employe'))]"/>
        </record>

        <!-- ── Directeur Général (catégorie 2, lecture seule stratégique) -->
        <record id="group_rh_directeur" model="res.groups">
            <field name="name">Directeur Général</field>
            <field name="category_id" ref="module_category_rh_fonctions_speciales"/>
            <field name="comment">Consulte les statistiques, rapports RH et indicateurs de performance. Accès en lecture seule à toutes les données.</field>
            <field name="implied_ids" eval="[(4, ref('group_rh_employe'))]"/>
        </record>

        <!-- ── Responsable Paie (catégorie 2) ───────────────────────── -->
        <record id="group_rh_paie" model="res.groups">
            <field name="name">Responsable Paie</field>
            <field name="category_id" ref="module_category_rh_fonctions_speciales"/>
            <field name="comment">Gère les salaires, primes, retenues et bulletins de paie. Accès confidentiel aux données salariales.</field>
            <field name="implied_ids" eval="[(4, ref('group_rh_user'))]"/>
        </record>

        <!-- ── Recruteur (catégorie 2) ───────────────────────────────── -->
        <record id="group_rh_recruteur" model="res.groups">
            <field name="name">Recruteur</field>
            <field name="category_id" ref="module_category_rh_fonctions_speciales"/>
            <field name="comment">Gère les offres d'emploi, candidatures et entretiens de recrutement.</field>
            <field name="implied_ids" eval="[(4, ref('group_rh_user'))]"/>
        </record>

        <!-- ── Responsable Formation (catégorie 2) ───────────────────── -->
        <record id="group_rh_formation" model="res.groups">
            <field name="name">Responsable Formation</field>
            <field name="category_id" ref="module_category_rh_fonctions_speciales"/>
            <field name="comment">Organise et suit les formations, gère le catalogue et les inscriptions des employés.</field>
            <field name="implied_ids" eval="[(4, ref('group_rh_user'))]"/>
        </record>

        <!-- ── Auditeur (catégorie 2, lecture seule globale) ─────────── -->
        <record id="group_rh_auditeur" model="res.groups">
            <field name="name">Auditeur</field>
            <field name="category_id" ref="module_category_rh_fonctions_speciales"/>
            <field name="comment">Lecture seule sur l'ensemble des données RH, sans pouvoir créer ni modifier.</field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════
             PARTIE 3 — RÈGLES D'ACCÈS AUX ENREGISTREMENTS (ir.rule)
             ───────────────────────────────────────────────────────────────
             Principe :
             • Les règles d'un même modèle se combinent en OR pour un groupe.
             • Les ACL (ir.model.access) contrôlent QUELLES opérations sont
               autorisées ; les règles filtrent SUR QUELS enregistrements.
             • perm_* = 1 : la règle s'applique à cette opération.

             Chemin département → chef :
             employe.departement_id.responsable_id.user_id = current_user
        ════════════════════════════════════════════════════════════════ -->

