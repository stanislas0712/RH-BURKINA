<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════ Documents du personnel ═══════════════ -->
    <record id="view_rh_document_list" model="ir.ui.view">
        <field name="name">rh.document.list</field>
        <field name="model">rh.document</field>
        <field name="arch" type="xml">
            <list decoration-danger="etat == 'expire'" decoration-warning="etat == 'bientot'">
                <field name="employee_id"/>
                <field name="type_document_id"/>
                <field name="name"/>
                <field name="reference" optional="show"/>
                <field name="date_emission" optional="hide"/>
                <field name="date_expiration"/>
                <field name="etat" widget="badge" decoration-danger="etat == 'expire'" decoration-warning="etat == 'bientot'" decoration-success="etat == 'valide'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_rh_document_form" model="ir.ui.view">
        <field name="name">rh.document.form</field>
        <field name="model">rh.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="ex. CNIB"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="type_document_id"/>
                            <field name="reference"/>
                        </group>
                        <group>
                            <field name="date_emission"/>
                            <field name="date_expiration"/>
                            <field name="etat"/>
                        </group>
                    </group>
                    <group>
                        <field name="fichier" filename="nom_fichier"/>
                        <field name="nom_fichier" invisible="1"/>
                    </group>
                    <field name="note" placeholder="Observations…"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rh_document_kanban" model="ir.ui.view">
        <field name="name">rh.document.kanban</field>
        <field name="model">rh.document</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="employee_id" class="text-muted"/>
                        <div>Expire le <field name="date_expiration"/></div>
                        <field name="etat" widget="badge"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_rh_document_search" model="ir.ui.view">
        <field name="name">rh.document.search</field>
        <field name="model">rh.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="type_document_id"/>
                <filter name="expire" string="Expirés" domain="[('etat', '=', 'expire')]"/>
                <filter name="bientot" string="Expirent sous 30 jours" domain="[('etat', '=', 'bientot')]"/>
                <separator/>
                <filter name="archived" string="Archivés" domain="[('active', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_type" string="Type" context="{'group_by': 'type_document_id'}"/>
                    <filter name="group_employe" string="Employé" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rh_document" model="ir.actions.act_window">
        <field name="name">Documents du personnel</field>
        <field name="res_model">rh.document</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <!-- ═══════════════ Types de documents ═══════════════ -->
    <record id="view_rh_type_document_list" model="ir.ui.view">
        <field name="name">rh.type.document.list</field>
        <field name="model">rh.type.document</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="a_expiration"/>
                <field name="delai_alerte_jours" invisible="not a_expiration"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_rh_type_document_search" model="ir.ui.view">
        <field name="name">rh.type.document.search</field>
        <field name="model">rh.type.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archivés" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_rh_type_document" model="ir.actions.act_window">
        <field name="name">Types de documents</field>
        <field name="res_model">rh.type.document</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
